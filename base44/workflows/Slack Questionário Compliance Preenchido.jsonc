{
  "name": "Slack: Question\u00e1rio Compliance Preenchido",
  "description": "Notifica no #compliance-sub quando um question\u00e1rio de compliance \u00e9 conclu\u00eddo",
  "trigger": {
    "condition": "${ ((.trigger.changed_fields | index(\"currentPhase\") != null) and (.trigger.data.currentPhase == \"completed\")) }",
    "config": {
      "trigger_type": "entity",
      "events": [
        "update"
      ],
      "entity_name": "ComplianceSession"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "slack_question_rio_compliance_preenchido",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "notifyComplianceCompleted",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "notifyComplianceCompleted"
  }
}