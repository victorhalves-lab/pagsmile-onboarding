{
  "name": "Email: Lead Pr\u00e9-Qualificado pela IA",
  "description": "Envia e-mail quando LeadQualifier pontua o lead (score BOM/EXCELENTE/REGULAR)",
  "trigger": {
    "condition": "${ (.trigger.changed_fields | index(\"leadQualifierScore\") != null) }",
    "config": {
      "trigger_type": "entity",
      "events": [
        "update"
      ],
      "entity_name": "Lead"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "email_lead_pr_qualificado_pela_ia",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "emailLeadQualified",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "emailLeadQualified"
  }
}