{
  "name": "On PixProposal Accepted \u2192 Mark Lead as Closed",
  "description": "Quando PixProposal vai para status='aceita', marca o Lead vinculado como 'proposta_aceita' (neg\u00f3cio fechado \u2014 cliente n\u00e3o assina contrato).",
  "trigger": {
    "condition": "${ ((.trigger.data.status == \"aceita\") and (.trigger.changed_fields | index(\"status\") != null)) }",
    "config": {
      "trigger_type": "entity",
      "events": [
        "update"
      ],
      "entity_name": "PixProposal"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "on_pixproposal_accepted_mark_lead_as_closed",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "onProposalAccepted",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "onProposalAccepted"
  }
}