{
  "name": "Email: Proposta Enviada ao Cliente",
  "description": "Envia e-mail ao cliente quando proposta muda para status 'enviada'",
  "trigger": {
    "condition": "${ (.trigger.data.status == \"enviada\") }",
    "config": {
      "trigger_type": "entity",
      "events": [
        "update"
      ],
      "entity_name": "Proposal"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "email_proposta_enviada_ao_cliente",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "emailProposalSent",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "emailProposalSent"
  }
}