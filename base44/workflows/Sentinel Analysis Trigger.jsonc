{
  "name": "Sentinel Analysis Trigger",
  "description": "Dispara an\u00e1lise autom\u00e1tica da IA SENTINEL quando um OnboardingCase \u00e9 criado ou atualizado",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "entity",
      "events": [
        "create",
        "update"
      ],
      "entity_name": "OnboardingCase"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "sentinel_analysis_trigger",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "analyzeOnboarding",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "analyzeOnboarding"
  }
}