{
  "name": "Slack: Lead PRISCILA Risco Alto/Cr\u00edtico",
  "description": "Alerta no #comercial-sub quando PRISCILA classifica lead como risco ALTO ou CRITICO",
  "trigger": {
    "condition": "${ (.trigger.changed_fields | index(\"priscilaRiskLevel\") != null) }",
    "config": {
      "trigger_type": "entity",
      "events": [
        "update"
      ],
      "entity_name": "Lead"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "slack_lead_priscila_risco_alto_cr_tico",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "notifyLeadHighRisk",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "notifyLeadHighRisk"
  }
}