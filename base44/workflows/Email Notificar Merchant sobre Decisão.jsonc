{
  "name": "Email: Notificar Merchant sobre Decis\u00e3o",
  "description": "Envia e-mail ao merchant quando o status do caso muda para Aprovado ou Recusado (decis\u00e3o autom\u00e1tica V4).",
  "trigger": {
    "condition": "${ ((.trigger.data.status == \"Aprovado\") or (.trigger.data.status == \"Recusado\")) }",
    "config": {
      "trigger_type": "entity",
      "events": [
        "update"
      ],
      "entity_name": "OnboardingCase"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "email_notificar_merchant_sobre_decis_o",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "notifyMerchantDecision",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "notifyMerchantDecision"
  }
}