{
  "name": "Slack: Contrato Enviado/Assinado/Cancelado",
  "description": "Notifica no #comercial-sub quando contrato muda de status (enviado, assinado, cancelado, pronto)",
  "trigger": {
    "condition": "${ (.trigger.changed_fields | index(\"status\") != null) }",
    "config": {
      "trigger_type": "entity",
      "events": [
        "update"
      ],
      "entity_name": "Contract"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "slack_contrato_enviado_assinado_cancelado",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "notifyContractUpdate",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "notifyContractUpdate"
  }
}