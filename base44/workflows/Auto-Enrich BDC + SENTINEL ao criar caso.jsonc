{
  "name": "Auto-Enrich: BDC + SENTINEL ao criar caso",
  "description": "Executa automaticamente o pipeline completo de risco (BDC + SENTINEL V4) quando um novo OnboardingCase \u00e9 criado. O cliente n\u00e3o v\u00ea nada \u2014 apenas o time interno recebe os resultados.",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "entity",
      "events": [
        "create"
      ],
      "entity_name": "OnboardingCase"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "auto_enrich_bdc_sentinel_ao_criar_caso",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "autoEnrichOnboarding",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "autoEnrichOnboarding"
  }
}