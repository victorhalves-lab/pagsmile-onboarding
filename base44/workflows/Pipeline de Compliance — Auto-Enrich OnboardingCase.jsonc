{
  "name": "Pipeline de Compliance \u2014 Auto-Enrich OnboardingCase",
  "description": "Dispara o pipeline unificado (BDC V4 \u2192 CAF post-capture \u2192 screening \u2192 SENTINEL relator \u2192 decis\u00e3o determin\u00edstica) sempre que um OnboardingCase \u00e9 criado, quando validationsCompleted != true, OU quando docCompleted/cafCompleted mudam. Garante que casos retidos pelo Doc Gate sejam re-processados ao completar a Etapa 2.",
  "trigger": {
    "condition": "${ ((.trigger.data.validationsCompleted != true) or (.trigger.changed_fields | index(\"docCompleted\") != null) or (.trigger.changed_fields | index(\"cafCompleted\") != null)) }",
    "config": {
      "trigger_type": "entity",
      "events": [
        "create",
        "update"
      ],
      "entity_name": "OnboardingCase"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "pipeline_de_compliance_auto_enrich_onboardingcase",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "autoEnrichOnboarding",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "autoEnrichOnboarding"
  }
}